rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Classroom pilot rules: any signed-in Firebase session may use the app.
    // Replace with role-based rules before storing sensitive information.
    match /academyMembers/{memberId} {
      allow read, write: if request.auth != null;
    }

    match /academyCareers/{careerId} {
      allow read, write: if request.auth != null;
    }
  }
}
